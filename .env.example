# IdeaHub
IDEAHUB_PORT=5173

# OpenAI-compatible model. DeepSeek is the recommended default.
MODEL_PROVIDER=deepseek
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-v4-flash
MODEL_API_KEY=

# Memos. Leave MEMOS_ACCESS_TOKEN empty until Memos has been initialized.
MEMOS_PORT=5230
MEMOS_BASE_URL=http://memos:5230
MEMOS_ACCESS_TOKEN=

# Optional: Cloudflare Tunnel for public HTTPS access.
# Start with: docker compose --profile tunnel up -d
CLOUDFLARED_TOKEN=
